{
  "rules": {
    ".read": "auth != null",
    ".write": false,

    "_migrated": {
      ".write": "auth != null && !data.exists()",
      ".validate": "newData.isNumber()"
    },

    "usuarios": {
      ".write": "auth != null && newData.exists()",
      "$slug": {
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['nome','role','salt','passHash'])",
        "nome":        {".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200"},
        "role":        {".validate": "newData.isString() && (newData.val() == 'admin' || newData.val() == 'medico')"},
        "salt":        {".validate": "newData.isString() && newData.val().matches(/^[0-9a-f]{32}$/)"},
        "passHash":    {".validate": "newData.isString() && newData.val().matches(/^[0-9a-f]{64}$/)"},
        "passChanged": {".validate": "newData.isBoolean()"},
        "setor":       {".validate": "newData.isString() && newData.val().length <= 60"},
        "criadoEm":    {".validate": "newData.isNumber()"},
        "$other":      {".validate": false}
      }
    },

    "setores": {
      ".write": "auth != null && newData.exists()",
      "$sector": {
        ".write": "auth != null",
        ".validate": "$sector.matches(/^[a-z_]{2,40}$/)",

        "mesVigente": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}$/))"
        },

        "meses": {
          "$mes": {
            ".validate": "$mes.matches(/^[0-9]{4}-[0-9]{2}$/)",

            "meta": {
              "uploadedAt": {".validate": "newData.isNumber()"},
              "uploadedBy": {".validate": "newData.isString()"},
              "count":      {".validate": "newData.isNumber()"}
            },

            "plantoes": {
              "$pid": {
                ".validate": "newData.hasChildren(['dataIso','turno','medico'])",
                "dataIso":     {".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"},
                "turno":       {".validate": "newData.isString() && (newData.val() == 'Manhã' || newData.val() == 'Tarde' || newData.val() == 'Noite')"},
                "medico":      {".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200"},
                "turnoLabel":  {".validate": "newData.isString() && newData.val().length <= 100"},
                "horaInicio":  {".validate": "newData.isString() && newData.val().matches(/^[0-9]{2}:[0-9]{2}$/)"},
                "categoria":   {".validate": "newData.isString() && newData.val().length <= 60"},
                "horas":       {".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 24"},
                "$other":      {".validate": false}
              }
            },

            "acionamentos": {
              "$key": {".validate": "newData.isBoolean() && newData.val() == true"}
            },

            "duracoes": {
              "$key": {".validate": "newData.isNumber() && (newData.val() == 4 || newData.val() == 6)"}
            },

            "horasExtras": {
              "$key": {".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 12"}
            },

            "produtividade": {
              "$pid": {
                ".validate": "newData.hasChildren(['dataIso','medicoSlug'])",
                "dataIso":     {".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"},
                "prt":         {".validate": "newData.isString() && newData.val().length <= 200"},
                "medicoSlug":  {".validate": "newData.isString() && newData.val().length <= 100"},
                "criadoEm":    {".validate": "newData.isNumber()"},
                "$other":      {".validate": false}
              }
            },

            "validacoes": {
              "$slug": {
                ".validate": "newData.hasChildren(['validadoEm'])",
                "validadoEm":  {".validate": "newData.isNumber()"},
                "validadoPor": {".validate": "newData.isString() && newData.val().length <= 200"},
                "$other":      {".validate": false}
              }
            },

            "extras": {
              "$slug": {".validate": "newData.isNumber()"}
            },

            "observacoes": {
              "$slug": {".validate": "newData.isString() && newData.val().length <= 5000"}
            },

            "overrides": {
              "$slug": {
                "$campo": {".validate": "newData.isNumber()"}
              }
            },

            "prt": {
              "$key": {".validate": "newData.isString() && newData.val().length <= 200"}
            }
          }
        }
      }
    }
  }
}
